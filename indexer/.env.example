RPC_URL=https://soroban-testnet.stellar.org
CONTRACT_ID=C...
POLL_INTERVAL_MS=5000
PORT=8787
DATABASE_PATH=./data/streampay.sqlite
# Required before the contract's first event when analytics is enabled.
# If omitted with analytics disabled, the indexer starts at the RPC's latest ledger.
START_LEDGER=
# Transactional outbox dispatcher (see docs/OUTBOX.md)
OUTBOX_TICK_MS=1000
OUTBOX_BATCH_SIZE=200
OUTBOX_CLAIM_TIMEOUT_MS=60000
# OUTBOX_MAX_DEPTH=          # global backpressure threshold (off when unset)
OUTBOX_ALARM_WINDOW=8
OUTBOX_ALARM_MIN_DEPTH=1000
# Light-client checkpoint proofs (GET /streams/:id/proof, see docs/SECURITY_LIGHT_CLIENT.md).
# Without a signer key the route answers 503; a real deploy must set it so clients
# can pin the verifier key that /health reports.
# CHECKPOINT_SIGNER_SECRET=S...
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Shared webhook subscriptions (docs/WEBHOOKS.md §7) ───────────────────────
# AES-256-GCM key for signing secrets at rest: 64 hex characters, or any
# passphrase (SHA-256'd). Unset, secrets stay plaintext as they always were.
# WEBHOOK_SECRET_ENCRYPTION_KEY=
# Refuse to store a secret in the clear: creations answer 503 without a key.
# WEBHOOK_REQUIRE_ENCRYPTION=1
# Tenant credentials presented as `x-streampay-webhook-key`, as tenantId:keyId:secret.
# Only the digest of each secret is kept. Unset, the deployment is single-tenant
# and the transport is trusted instead.
# WEBHOOK_TENANT_KEYS=acme:k1:stdp_whk_...,globex:k1:stdp_whk_...
# WEBHOOK_DEFAULT_TENANT_ID=acme
# Per-tenant ceilings.
WEBHOOK_TENANT_QUOTA_SUBSCRIPTIONS=20
WEBHOOK_TENANT_QUOTA_EVENTS=24
WEBHOOK_TENANT_QUOTA_ROTATIONS=6
# How long a rotated-out secret keeps verifying, and how often expired
# overlaps are retired.
WEBHOOK_SECRET_ROTATION_OVERLAP_MS=86400000
# Delivery commitment per attempt, the fraction of the window allowed to miss
# it, and the window depth required before the breach alarm may engage.
WEBHOOK_SLA_MS=5000
WEBHOOK_SLA_BREACH_BUDGET=0.01
WEBHOOK_SLA_MIN_SAMPLES=20

# ── Heuristic anomaly detection (docs/ANOMALY.md) ───────────────────────────
# Deployment-wide rule configuration, keyed by rule id: { mode, severity,
# params, false_positive_budget, min_reviews }. Unknown rule ids, unknown param
# names, and numbers outside a param's range fail the boot instead of silently
# running defaults.
# ANOMALY_RULES_JSON={"burst_creation":{"params":{"threshold":40}}}
# Mode for every rule neither the base nor a tenant named. shadow records
# detections and pages nobody: a rule this deployment has not measured has not
# earned a page.
ANOMALY_MODE=shadow
# An incident must hold one state this long before the transition is reported,
# so a flickering subject cannot page twice.
ANOMALY_FLAP_WINDOW_MS=120000
# Re-raise a still-open incident after this long; 0 disables heartbeats.
ANOMALY_RENOTIFY_AFTER_MS=0
# Windows are measured in event time, so a restart rebuilds them from the last
# this many ledgers. 0 skips hydration: wide-window rules then under-report
# until the pattern advances past the gap on its own.
ANOMALY_HYDRATE_LEDGERS=2880
# Rows one boot may read while hydrating; a truncated range is logged.
ANOMALY_HYDRATE_MAX_EVENTS=50000
# How long a false-positive review suppresses its subject (a request may ask for
# less; the clamp is 30 days).
ANOMALY_SUPPRESSION_TTL_MS=86400000
# Rows one replay may read, so a citation cannot be turned into a DoS.
ANOMALY_REPLAY_MAX_EVENTS=50000
# Set to 0 to keep alerts in the log only instead of fanning them out through
# each tenant's webhook subscriptions as `anomaly_alert`.
ANOMALY_WEBHOOK_ALERTS=1

# ── Incremental materialized analytics (docs/ANALYTICS.md) ───────────────────
# The journal is folded in bounded transactions. Keep the events/second budget
# above sustained ingestion; the SLO is measured in chain event time.
ANALYTICS_ENABLED=1
ANALYTICS_BUCKET_MS=3600000
ANALYTICS_REFRESH_MS=1000
ANALYTICS_BATCH_SIZE=500
ANALYTICS_SLO_MS=30000
ANALYTICS_MAX_WAIT_MS=5000
ANALYTICS_WAIT_POLL_MS=50
ANALYTICS_THROUGHPUT_BUDGET_EPS=500
# Required in production: every /api/analytics/* request sends this bearer token.
ANALYTICS_API_TOKEN=
# Per-client fixed-window budget for POST refresh/rebuild; excess receives 429.
ANALYTICS_MUTATION_RATE_PER_SEC=5
# Exact trusted reverse-proxy depth for client IPs. Keep 0 when directly exposed.
TRUST_PROXY_HOPS=0
