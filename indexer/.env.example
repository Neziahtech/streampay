RPC_URL=https://soroban-testnet.stellar.org
CONTRACT_ID=C...
POLL_INTERVAL_MS=5000
PORT=8787
DATABASE_PATH=./data/streampay.sqlite
# Set this to a ledger before the contract's first event for a full backfill.
# If omitted, the indexer starts at the RPC's latest ledger.
START_LEDGER=
# Transactional outbox dispatcher (see docs/OUTBOX.md)
OUTBOX_TICK_MS=1000
OUTBOX_BATCH_SIZE=200
OUTBOX_CLAIM_TIMEOUT_MS=60000
# OUTBOX_MAX_DEPTH=          # global backpressure threshold (off when unset)
OUTBOX_ALARM_WINDOW=8
OUTBOX_ALARM_MIN_DEPTH=1000
# Light-client checkpoint proofs (GET /streams/:id/proof, see docs/SECURITY_LIGHT_CLIENT.md).
# Without a signer key the route answers 503; a real deploy must set it so clients
# can pin the verifier key that /health reports.
# CHECKPOINT_SIGNER_SECRET=S...
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
