{
  "$defs": {},
  "$id": "https://streampay.dev/schemas/events/v1/events/stream_refund_target_changed.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Emitted whenever the refund claim of a stream is pinned to a new address — at creation (`create_stream_with_refund`) or later by the sender (`set_refund_target`). The unstreamed remainder of the deposit is paid to `new_target` on cancellation instead of to the sender. Accrual, the recipient's claims and who may cancel are untouched: this is a destination change, not a value change.",
  "properties": {
    "at_creation": {
      "type": "boolean",
      "x-soroban-type": "bool"
    },
    "new_target": {
      "description": "Stellar account or contract address (StrKey).",
      "type": "string",
      "x-soroban-type": "Address"
    },
    "previous_target": {
      "description": "Stellar account or contract address (StrKey).",
      "type": "string",
      "x-soroban-type": "Address"
    }
  },
  "required": [
    "previous_target",
    "new_target",
    "at_creation"
  ],
  "title": "StreamRefundTargetChanged",
  "type": "object",
  "x-streampay": {
    "event_key": "stream_refund_target_changed",
    "fingerprint": "sha256:20f8ba96f8e86083b6e7f70644ec49d8958349f8dc3b1ee7462e3868dae8d943",
    "registry_version": 1,
    "topicSchema": {
      "items": [
        {
          "minimum": 0,
          "type": "integer",
          "x-soroban-type": "u64"
        }
      ],
      "type": "array"
    },
    "topics": [
      {
        "name": "stream_id",
        "type": "u64"
      }
    ]
  }
}
