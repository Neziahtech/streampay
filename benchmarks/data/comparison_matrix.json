      "sablier_v2": {
        "native_units": "0 gas / sec",
        "usd_per_second": 0.0,
        "usd_per_30_days": 0.0,
        "protocol_mechanism": "None on EVM (zero ongoing storage rent; storage paid 100% upfront via SSTORE gas at stream creation)",
