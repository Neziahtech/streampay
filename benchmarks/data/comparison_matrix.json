{
  "benchmark_metadata": {
    "version": "1.0.0",
    "updated_at": "2026-10-19",
    "description": "Cross-chain reproducible streaming benchmark comparing StreamPay, Sablier V2, and Superfluid CFA on storage, claim, cancel, and rent axes."
  },
  "economic_assumptions": {
    "eth_price_usd": 3000.0,
    "xlm_price_usd": 0.12,
    "matic_price_usd": 0.50,
    "gas_prices": {
      "ethereum_l1_gwei": 20.0,
      "arbitrum_l2_gwei": 0.1,
      "polygon_pos_gwei": 35.0,
      "stellar_stroop_base": 100
    }
  },
  "comparison_axes": {
    "storage_bytes_per_stream": {
      "streampay": {
        "raw_bytes": 484,
        "description": "444 B Stream struct + 40 B persistent ledger DataKey (XDR encoded)",
        "keys_count": 1,
        "additional_index_bytes": "76 B per index entry (amortized)",
        "state_model": "Stellar persistent ledger entry (subject to TTL / State Archival)"
      },
      "sablier_v2": {
        "raw_bytes": 128,
        "description": "4 EVM storage slots (32 bytes each) + 32 B ERC-721 ownership mapping entry",
        "keys_count": 4,
        "additional_index_bytes": "ERC-721 enumeration (if enabled: additional 2 slots)",
        "state_model": "EVM permanent contract storage (perpetual state bloat, no rent)"
      },
      "superfluid_cfa": {
        "raw_bytes": 128,
        "description": "2 slots agreement struct + 2 slots sender/receiver net-flow rate accumulator in SuperToken",
        "keys_count": 4,
        "additional_index_bytes": "Agreement bitmap tracking (1 bit per active agreement)",
        "state_model": "EVM permanent contract storage (perpetual state bloat, no rent)"
      }
    },
    "cost_per_second_of_stream_life": {
