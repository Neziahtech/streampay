{
  "name": "streampay-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal StreamPay UI: create streams, withdraw accrued funds, top up or cancel — Next.js + Freighter.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test && vitest run",
    "test:i18n": "vitest run lib/i18n/catalog.spec.ts",
    "test:accrual": "node --test lib/accrual.test.ts",
    "test:scheduler": "vitest run",
    "test:parity": "node --experimental-strip-types --test test/client-parity.test.ts",
    "test:a11y": "node --experimental-strip-types --test test/a11y.test.ts",
    "generate:openapi": "npx tsx scripts/generate-openapi.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "test:visual": "playwright test",
    "test:visual:baselines": "bash scripts/visual-baselines.sh"
  },
  "dependencies": {
    "@albedo-link/intent": "^0.13.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.3.0",
    "intl-messageformat": "^12.1.4",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/nextjs-vite": "10.6.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "4.14.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.2",
    "jsdom": "30.1.3",
    "storybook": "10.6.5",
    "typescript": "^5.7.0",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "toml": "4.3.0"
  }
}
